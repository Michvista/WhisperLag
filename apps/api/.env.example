# Copy to .env and adjust as needed.
NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://user:password@host:5432/db?sslmode=require"
JWT_SECRET=whisperlag-dev-secret-change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# AI Insights (optional). Without these the insights endpoint falls back to
# a deterministic keyword/rule clustering algorithm.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional live SIS/LMS connector. When unset, admins import SIS exports manually.
SIS_API_URL=

# Cloudinary Media Storage (required for persistent file/image uploads on hosted platforms like Render)
# Sign up at https://cloudinary.com and get these from your Cloudinary Dashboard:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternatively, you can use the single CLOUDINARY_URL string:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>